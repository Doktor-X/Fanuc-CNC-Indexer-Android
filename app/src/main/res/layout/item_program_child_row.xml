<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:paddingEnd="12dp"
    android:background="?attr/selectableItemBackground">

    <!-- Indent marker -->
    <View
        android:id="@+id/indent_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="#E65100"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_child_filename"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/indent_line"
        app:layout_constraintEnd_toStartOf="@id/badge_child_problem" />

    <TextView
        android:id="@+id/badge_child_problem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚠"
        android:textSize="10sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/badge_problem"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_child_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintTop_toBottomOf="@id/tv_child_filename"
        app:layout_constraintStart_toEndOf="@id/indent_line"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
